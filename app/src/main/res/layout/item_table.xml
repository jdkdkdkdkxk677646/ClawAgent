<?xml version="1.0" encoding="utf-8"?>
<!--
    表格 Segment 的宿主。横向滚动只在这一行启用（其余消息内容不受影响），
    高度 wrap_content 不锁高：行数多的表格纵向自然展开，不做内部竖向滚动。
    fillViewport 让列宽总和不足时表格撑满气泡可用宽度；内容更宽时
    TableLayout 保持内容宽，横向滚动交给本层处理。
-->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tableScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:fillViewport="true">

    <!-- stretchColumns=* 配合 fillViewport：窄表各列均分填满，宽表原样滚动 -->
    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="@drawable/table_divider"
        android:showDividers="middle"
        android:stretchColumns="*" />
</HorizontalScrollView>
