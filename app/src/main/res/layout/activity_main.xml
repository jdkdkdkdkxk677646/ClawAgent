<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f1117">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#1a1d27">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Claw Agent"
            android:textColor="#e2e8f0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_dot"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/newChatBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_bg"
            android:tint="#94a3b8"
            android:backgroundTint="#22263a"
            android:contentDescription="新对话"
            android:layout_marginEnd="4dp"
            android:text="+" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_bg"
            android:tint="#94a3b8"
            android:backgroundTint="#22263a"
            android:contentDescription="设置"
            android:src="@android:drawable/ic_menu_preferences" />
    </LinearLayout>

    <!-- Welcome Screen -->
    <LinearLayout
        android:id="@+id/welcomeLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🦀"
            android:textSize="72sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Claw Agent"
            android:textColor="#e2e8f0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="你的智能助手，随时待命"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnQuick1"
                android:onClick="sendQuick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="查天气"
                android:textSize="13sp"
                android:background="@drawable/quick_btn_bg"
                android:textColor="#e2e8f0"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnQuick2"
                android:onClick="sendQuick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="讲笑话"
                android:textSize="13sp"
                android:background="@drawable/quick_btn_bg"
                android:textColor="#e2e8f0"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnQuick3"
                android:onClick="sendQuick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="写代码"
                android:textSize="13sp"
                android:background="@drawable/quick_btn_bg"
                android:textColor="#e2e8f0"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/btnQuick4"
                android:onClick="sendQuick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="解释概念"
                android:textSize="13sp"
                android:background="@drawable/quick_btn_bg"
                android:textColor="#e2e8f0"
                android:layout_margin="4dp" />
        </GridLayout>
    </LinearLayout>

    <!-- Chat RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

    <!-- Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#0f1117"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1a1d27"
            android:hint="和 Claw 说点什么..."
            android:textColor="#e2e8f0"
            android:textColorHint="#64748b"
            android:textSize="15sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:maxLines="5"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/send_btn_bg"
            android:tint="#ffffff"
            android:layout_marginStart="10dp"
            android:contentDescription="发送" />
    </LinearLayout>
</LinearLayout>
